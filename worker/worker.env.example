# `worker.env` 로 복사해 채운다. `worker.env` 는 커밋되지 않는다.
# 키 목록의 정본은 팀 저장소 `agent/deploy/worker.env.example` 이다 — 여기엔
# **자가 호스팅에서 달라지는 것**에만 주석을 단다.

# 🔴 백엔드 `.env` 의 `WORKER_TOKEN` 과 **같은 값**이어야 한다. 다르면 claim 이
#    전부 401 이다. ASCII 만(HTTP 헤더에 실린다).
SUPERSUB_WORKER_TOKEN=

# 공개 주소를 써도 된다 — 워커는 UA 를 직접 설정해서 이 영역의
# `Python-urllib` 차단에 안 걸린다.
SUPERSUB_API_BASE=https://supersub-api.example.com/api/v1

SUPERSUB_S3_BUCKET=supersub
SUPERSUB_REPORTS_URI=s3://supersub/reports

# 🔴 **비워 둔다.** 비면 transformers 로 EXAONE 을 직접 올린다 — 8GB 에서
#    자세 추출과 순차로 돈다. vLLM 을 따로 띄우면 둘이 동시에 GPU 를 잡는다.
SUPERSUB_VLLM_URL=

SUPERSUB_POLL_SECONDS=5
SUPERSUB_ANALYZE_TIMEOUT=3600

# --- 저장소 (MinIO) -----------------------------------------------------------
# 🔴 **NodePort 로 직결한다**(`k8s/20-minio.yaml`). 공개 주소로 가면 Cloudflare
#    를 돌고, 거기서 HEAD 첫 요청이 403 이 난다(README 「해결」 절). 인증서 SAN 에
#    `localhost` 를 넣어 둬서 검증이 통과한다 — CA 는 `run.sh` 가 넣는다.
AWS_ENDPOINT_URL_S3=https://localhost:30900
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
