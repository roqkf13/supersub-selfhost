# 이 파일을 `.env` 로 복사해 값을 채운다. `.env` 는 커밋되지 않는다.
#
# 키 목록의 정본은 팀 저장소 `fastapi/.env.example` 이고, 배포에서 주의할 것은
# `fastapi/docs/deployment.md` 2절에 있다. 여기서는 **자가 호스팅에서 달라지는
# 것**에 주석을 단다.

# --- 어느 이미지를 띄우나 -------------------------------------------------------
# 팀 CI 가 올리는 이미지는 비공개 레지스트리에 있어 그대로는
# 못 받는다(README 「이미지」 참고). 직접 빌드했으면 그 태그를 적는다.
BACKEND_IMAGE=supersub-backend:local

# --- 앱 -----------------------------------------------------------------------
# 🔴 비우면 기본값이 `local` 이라 `/docs`·`/openapi.json` 이 **열린 채로 정상
#    동작한다**. 다른 키는 빠지면 기능이 멈춰 바로 드러나는데 이것만 반대다.
APP_ENV=prod

# 로그인이 이 값에 달려 있다. 없으면 503(`AUTH_NOT_CONFIGURED`).
# 만들기: openssl rand -hex 32
JWT_SECRET=

# 구글 로그인. 플랫폼마다 ID 가 다르니 **쉼표로 전부** 넣는다. 없으면 503.
GOOGLE_CLIENT_IDS=

# 회원 관리 admin. 비면 admin 경로가 통째로 403.
ADMIN_EMAILS=

# 용병 매칭 임베딩. 비면 프로필 수정·후보 검색이 503(`EMBEDDING_NOT_CONFIGURED`).
GEMINI_API_KEY=

# 분석 워커가 작업을 claim 할 때 쓰는 토큰.
WORKER_TOKEN=

ANALYSIS_JOB_TIMEOUT_MINUTES=30
PROVISIONAL_VIDEO_TTL_HOURS=24
UPLOAD_URL_TTL_SECONDS=900

# --- DB -------------------------------------------------------------------------
POSTGRES_DB=supersub
POSTGRES_USER=supersub
POSTGRES_PASSWORD=

# 🔴 `DATABASE_URL` 을 주면 앱이 `RDS_*` 조립을 건너뛴다. 컨테이너 사이는 평문
#    네트워크라 `sslmode=require` 를 붙이지 않는다 — 붙이면 접속이 거절된다.
#    비밀번호는 위 POSTGRES_PASSWORD 와 **같은 값**이어야 한다.
DATABASE_URL=postgresql://supersub:CHANGE_ME@postgres:5432/supersub

# --- 저장소 (S3 -> MinIO) --------------------------------------------------------
S3_BUCKET=supersub
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# boto3 기본 자격증명 체인이 읽는다. MinIO 루트 값과 같게 둔다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# MinIO 는 리전을 안 보지만 boto3 가 하나를 요구한다.
AWS_REGION=us-east-1

# 🔴 **여기가 이 파일에서 가장 헷갈리는 자리다.**
# 앱은 브라우저가 직접 PUT 할 **사전 서명 URL** 을 이 엔드포인트로 만든다.
# 그래서 이 값은 **브라우저에서 닿는 공개 주소**여야 한다 — `http://minio:9000`
# 같은 컨테이너 내부 이름을 넣으면 업로드가 브라우저에서 실패한다.
#
# - 터널을 붙이기 전(로컬 단계): http://localhost:9000
# - 터널을 붙인 뒤:              https://supersub-storage.example.com
#
# 백엔드도 같은 이름으로 MinIO 에 말한다. 그대로 두면 트래픽이 터널을 한 번 돌아
# 나갔다 들어오므로, 파드 안에서만 그 이름을 MinIO 로 푼다(`k8s/wire-direct.sh` ·
# README 「HEAD 첫 요청 403」) — 앱 코드가 클라이언트를 둘 만들 필요가 없다.
AWS_ENDPOINT_URL_S3=http://localhost:9000

# 로컬에서 백엔드를 직접 두드릴 포트.
BACKEND_LOCAL_PORT=8080
